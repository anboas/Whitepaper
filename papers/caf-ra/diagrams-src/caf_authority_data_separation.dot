digraph CAFAuthorityData {
  rankdir=TB;
  graph [
    bgcolor="white",
    pad="0.20",
    nodesep="0.52",
    ranksep="0.62",
    labelloc="t",
    label="CAF Separation: Authority Lane vs Data Lane"
  ];

  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#204060", fontname="Arial", fontsize=10.3];
  edge [color="#204060", arrowsize=0.74, penwidth=1.15];

  subgraph cluster_auth {
    label="Authority Lane";
    color="#9A3412";
    style="rounded,dashed";
    ASM [label="Assurance Scope Manifest (ASM)", fillcolor="#FFF7ED", color="#9A3412"];
    Policy [label="Policy Bundle", fillcolor="#FFF7ED", color="#9A3412"];
    Decision [label="Signed Decision Record\n(policy hash + ASM hash + refs)", fillcolor="#FFF7ED", color="#9A3412"];
    Action [label="Action Records\n(from ACT)", fillcolor="#EEF6FF", color="#1D4ED8"];
    ASM -> Decision [style=dashed, color="#9A3412", penwidth=1.30];
    Policy -> Decision [style=dashed, color="#9A3412", penwidth=1.30];
    Decision -> Action [style=dotted, color="#64748B", penwidth=1.0];
  }

  subgraph cluster_data {
    label="Data Lane";
    color="#1D4ED8";
    style="rounded,dashed";
    Evidence [label="Evidence Envelopes", fillcolor="#EEF6FF", color="#1D4ED8"];
    Posture [label="Posture + Confidence", fillcolor="#EEF6FF", color="#1D4ED8"];
    Surface [label="Decision Surface", fillcolor="#EEF6FF", color="#1D4ED8"];
    Evidence -> Posture -> Surface;
  }

  Evidence -> Decision [label="reference-only linkage", style=dotted, color="#64748B", fontcolor="#64748B", fontsize=8.4];
  Posture -> Decision [label="reference-only linkage", style=dotted, color="#64748B", fontcolor="#64748B", fontsize=8.4];

  Verify [label="Verification / closure evidence", fillcolor="#ECFDF5", color="#166534"];
  Decision -> Verify [style=bold, color="#166534", penwidth=1.9];
  Verify -> Surface [style=bold, color="#166534", penwidth=1.9];

  Ledger [label="Proof ledger\n(anchors evidence + decisions + actions)", fillcolor="#ECFDF5", color="#166534"];
  Evidence -> Ledger [style=dashed, color="#166534", penwidth=1.2, label="anchor", fontsize=8.5, fontcolor="#166534"];
  Decision -> Ledger [style=dashed, color="#166534", penwidth=1.2, label="anchor", fontsize=8.5, fontcolor="#166534"];
  Action -> Ledger [style=dashed, color="#166534", penwidth=1.2, label="anchor", fontsize=8.5, fontcolor="#166534"];

  Guard [label="Rule: score informs,\nscore does NOT grant authority", shape=note, fillcolor="#FEF2F2", color="#991B1B", fontsize=9.6];
  Posture -> Guard [style=dotted, color="#991B1B"];

  Legend [
    shape=box,
    style="rounded,filled",
    fillcolor="#F8FAFC",
    color="#64748B",
    fontname="Arial",
    fontsize=8.5,
    margin="0.06,0.05",
    label="Legend:\nsolid=data flow | dashed=authority/control constraint\ndotted=reference-only linkage | bold solid=verification/closure"
  ];

  { rank=sink; Legend; }
  Ledger -> Legend [style=invis, weight=0.01, constraint=false];
}
