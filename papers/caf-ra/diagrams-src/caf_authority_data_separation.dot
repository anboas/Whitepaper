digraph CAFAuthorityData {
  rankdir=LR;
  graph [
    bgcolor="white",
    pad="0.20",
    nodesep="0.62",
    ranksep="0.72",
    labelloc="t",
    label="CAF Separation: Authority Lane vs Data Lane"
  ];

  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#204060", fontname="Arial", fontsize=10.5];
  edge [color="#204060", arrowsize=0.75, penwidth=1.2];

  subgraph cluster_auth {
    label="Authority Lane";
    color="#9A3412";
    style="rounded,dashed";
    ASM [label="Assurance Scope Manifest (ASM)", fillcolor="#FFF7ED", color="#9A3412"];
    Policy [label="Policy Bundle", fillcolor="#FFF7ED", color="#9A3412"];
    Decision [label="Decision Record\n(policy hash + ASM hash + refs)", fillcolor="#FFF7ED", color="#9A3412"];
    ASM -> Decision [style=dashed, color="#9A3412", penwidth=1.35];
    Policy -> Decision [style=dashed, color="#9A3412", penwidth=1.35];
  }

  subgraph cluster_data {
    label="Data Lane";
    color="#1D4ED8";
    style="rounded,dashed";
    Evidence [label="Evidence Envelopes", fillcolor="#EEF6FF", color="#1D4ED8"];
    Posture [label="Posture + Confidence", fillcolor="#EEF6FF", color="#1D4ED8"];
    Surface [label="Decision Surface", fillcolor="#EEF6FF", color="#1D4ED8"];
    Evidence -> Posture -> Surface;
  }

  Evidence -> Decision [label="reference-only linkage", style=dotted, color="#64748B", fontcolor="#64748B", fontsize=8.7];
  Posture -> Decision [label="reference-only linkage", style=dotted, color="#64748B", fontcolor="#64748B", fontsize=8.7];

  Verify [label="Verification / closure evidence", fillcolor="#ECFDF5", color="#166534"];
  Decision -> Verify [style=bold, color="#166534", penwidth=2.0];
  Verify -> Surface [style=bold, color="#166534", penwidth=2.0];

  Guard [label="Rule: score informs,\nscore does NOT grant authority", shape=note, fillcolor="#FEF2F2", color="#991B1B", fontsize=10];
  Posture -> Guard [style=dotted, color="#991B1B"];

  Legend [
    shape=box,
    style="rounded,filled",
    fillcolor="#F8FAFC",
    color="#64748B",
    fontname="Arial",
    fontsize=8.8,
    margin="0.06,0.05",
    label="Legend: solid = data flow | dashed = authority/control constraint | dotted = reference-only linkage | bold solid = verification/closure"
  ];

  { rank=sink; Legend; }
  Verify -> Legend [style=invis, weight=0.01, constraint=false];
}
