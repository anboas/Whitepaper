digraph CAFCore {
  rankdir=LR;
  graph [
    bgcolor="white",
    pad="0.20",
    nodesep="0.55",
    ranksep="0.70",
    labelloc="t",
    label="CAF Core Loop"
  ];

  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#204060", fontname="Arial", fontsize=11.5];
  edge [color="#204060", arrowsize=0.78, penwidth=1.35];

  Runtime [label="Runtime Plane\n(factory, runtime, identity, network, data)", fillcolor="#EEF6FF"];
  Emit [label="EMIT"];
  Enrich [label="ENRICH"];
  Score [label="SCORE"];
  Surface [label="SURFACE"];
  Act [label="ACT"];

  Governance [label="Governance Overlay\n(ASM + policy bundles)", fillcolor="#FFF7ED", color="#9A3412"];

  Substrate [
    shape=box,
    style="rounded,filled",
    fixedsize=true,
    width=7.8,
    height=0.42,
    fillcolor="#F1F5F9",
    color="#94A3B8",
    fontsize=9.4,
    label="Anchoring substrate: proof ledger (replay/tamper detection)"
  ];

  Runtime -> Emit;
  Emit -> Enrich -> Score -> Surface -> Act;

  Governance -> Emit   [style=dashed, color="#9A3412", penwidth=1.35];
  Governance -> Enrich [style=dashed, color="#9A3412", penwidth=1.35];
  Governance -> Score  [style=dashed, color="#9A3412", penwidth=1.35];
  Governance -> Surface[style=dashed, color="#9A3412", penwidth=1.35];
  Governance -> Act    [style=dashed, color="#9A3412", penwidth=1.35];

  Enrich -> Substrate [style=dashed, color="#166534", penwidth=1.35, label="anchor evidence", fontsize=9.0, fontcolor="#166534"];
  Act -> Substrate    [style=dashed, color="#166534", penwidth=1.35, label="anchor decision/action records", fontsize=9.0, fontcolor="#166534"];

  Legend [
    shape=box,
    style="rounded,filled",
    fillcolor="#F8FAFC",
    color="#64748B",
    fontname="Arial",
    fontsize=8.8,
    margin="0.06,0.05",
    label="Legend:\nsolid=data flow | dashed=authority/control constraint\ndotted=reference-only linkage | bold solid=verification/closure"
  ];

  { rank=sink; Substrate; Legend; }
  Substrate -> Legend [style=invis, weight=0.01, constraint=false];
}
