digraph CAFFederation {
  rankdir=TB;
  graph [
    bgcolor="white",
    pad="0.18",
    nodesep="0.58",
    ranksep="0.62",
    labelloc="t",
    label="Federated Posture Exchange (Summary by Default)"
  ];

  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#204060", fontname="Arial", fontsize=10.2];
  edge [color="#204060", arrowsize=0.74, penwidth=1.20];

  subgraph cluster_a {
    label="Enclave A";
    color="#94A3B8";
    style="rounded,dashed";
    APolicy [label="ASM + Policy Bundles", fillcolor="#EEF6FF"];
    AEvidence [label="Evidence + Decisions", fillcolor="#EEF6FF"];
    ASummary [label="Posture Summary\n(minimized)"];
  }

  Broker [label="Exchange Boundary\n(contract + conformance checks)", fillcolor="#FFF7ED", color="#9A3412"];

  subgraph cluster_b {
    label="Enclave B";
    color="#94A3B8";
    style="rounded,dashed";
    BPolicy [label="ASM + Policy Bundles", fillcolor="#EEF6FF"];
    BEvidence [label="Evidence + Decisions", fillcolor="#EEF6FF"];
    BSummary [label="Posture Summary\n(minimized)"];
  }

  ASummary -> Broker;
  Broker -> BSummary;
  BSummary -> Broker;
  Broker -> ASummary;

  APolicy -> ASummary [style=dashed, color="#9A3412", penwidth=1.22];
  AEvidence -> ASummary [style=dashed, color="#9A3412", penwidth=1.22];
  BPolicy -> BSummary [style=dashed, color="#9A3412", penwidth=1.22];
  BEvidence -> BSummary [style=dashed, color="#9A3412", penwidth=1.22];

  Conformance [label="Verification / closure\n(conformance + reconciliation)", fillcolor="#ECFDF5", color="#166534"];
  Broker -> Conformance [style=bold, color="#166534", penwidth=1.9];

  Intersection [label="Effective authority =\nintersection(ASM_A, ASM_B)", shape=note, fillcolor="#FFF7ED", color="#9A3412", fontsize=9.2];
  Broker -> Intersection [style=dashed, color="#9A3412", penwidth=1.15];

  RawMove [label="Raw evidence movement\n(exception-only, governed)", shape=note, fillcolor="#FEF2F2", color="#991B1B", fontname="Arial", fontsize=9.5];
  Broker -> RawMove [style=dotted, color="#991B1B"];

  Legend [
    shape=box,
    style="rounded,filled",
    fillcolor="#F8FAFC",
    color="#64748B",
    fontname="Arial",
    fontsize=8.2,
    margin="0.05,0.04",
    label="Legend:\nsolid=data flow | dashed=authority/control constraint\ndotted=reference-only linkage | bold solid=verification/closure"
  ];

  { rank=sink; Legend; }
  Conformance -> Legend [style=invis, weight=0.01, constraint=false];
}
