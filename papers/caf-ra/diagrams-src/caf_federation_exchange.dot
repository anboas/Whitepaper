digraph CAFFederation {
  rankdir=LR;
  graph [
    bgcolor="white",
    pad="0.20",
    nodesep="0.70",
    ranksep="0.70",
    labelloc="t",
    label="Federated Posture Exchange (Summary by Default)"
  ];

  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#204060", fontname="Arial", fontsize=10.8];
  edge [color="#204060", arrowsize=0.75, penwidth=1.25];

  subgraph cluster_a {
    label="Enclave A";
    color="#94A3B8";
    style="rounded,dashed";
    APolicy [label="ASM + Policy Bundles", fillcolor="#EEF6FF"];
    AEvidence [label="Evidence + Decisions", fillcolor="#EEF6FF"];
    ASummary [label="Posture Summary\n(minimized)"];
  }

  Broker [label="Exchange Boundary\n(contract + conformance checks)", fillcolor="#FFF7ED", color="#9A3412"];

  subgraph cluster_b {
    label="Enclave B";
    color="#94A3B8";
    style="rounded,dashed";
    BPolicy [label="ASM + Policy Bundles", fillcolor="#EEF6FF"];
    BEvidence [label="Evidence + Decisions", fillcolor="#EEF6FF"];
    BSummary [label="Posture Summary\n(minimized)"];
  }

  ASummary -> Broker;
  Broker -> BSummary;
  BSummary -> Broker;
  Broker -> ASummary;

  APolicy -> ASummary [style=dashed, color="#9A3412", penwidth=1.3];
  AEvidence -> ASummary [style=dashed, color="#9A3412", penwidth=1.3];
  BPolicy -> BSummary [style=dashed, color="#9A3412", penwidth=1.3];
  BEvidence -> BSummary [style=dashed, color="#9A3412", penwidth=1.3];

  Conformance [label="Verification / closure\n(conformance + reconciliation)", fillcolor="#ECFDF5", color="#166534"];
  Broker -> Conformance [style=bold, color="#166534", penwidth=2.0];

  Intersection [label="Effective authority =\nintersection(ASM_A, ASM_B)", shape=note, fillcolor="#FFF7ED", color="#9A3412", fontsize=9.6];
  Broker -> Intersection [style=dashed, color="#9A3412", penwidth=1.2];

  RawMove [label="Raw evidence movement\n(exception-only, governed)", shape=note, fillcolor="#FEF2F2", color="#991B1B", fontname="Arial", fontsize=10];
  Broker -> RawMove [style=dotted, color="#991B1B"];

  Legend [
    shape=box,
    style="rounded,filled",
    fillcolor="#F8FAFC",
    color="#64748B",
    fontname="Arial",
    fontsize=8.8,
    margin="0.06,0.05",
    label="Legend: solid = data flow | dashed = authority/control constraint | dotted = reference-only linkage | bold solid = verification/closure"
  ];

  { rank=sink; Legend; }
  Conformance -> Legend [style=invis, weight=0.01, constraint=false];
}
