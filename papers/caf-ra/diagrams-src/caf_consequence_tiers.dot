digraph CAFConsequenceTiers {
  rankdir=TB;
  graph [
    bgcolor="white",
    pad="0.20",
    nodesep="0.50",
    ranksep="0.62",
    labelloc="t",
    label="Consequence Tiers vs Action Eligibility"
  ];

  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#204060", fontname="Arial", fontsize=10.8, margin="0.10,0.08"];
  edge [color="#204060", arrowsize=0.74, penwidth=1.2];

  T1 [label="Tier 1 (low consequence)\nEvidence: baseline confidence\nApprovals: pre-authorized policy\nRate limits: permissive\nRollback: standard\nEligible actions: bounded automation", fillcolor="#ECFDF5", color="#166534"];

  T2 [label="Tier 2 (moderate consequence)\nEvidence: stronger corroboration\nApprovals: explicit reviewer\nRate limits: tighter\nRollback: pre-staged\nEligible actions: narrowed automation", fillcolor="#EEF6FF", color="#1D4ED8"];

  T3 [label="Tier 3 (high consequence)\nEvidence: high-confidence + provenance checks\nApprovals: dual control\nRate limits: strict\nRollback: rehearsed + fast\nEligible actions: constrained containment only", fillcolor="#FFF7ED", color="#9A3412"];

  T4 [label="Tier 4 (critical consequence)\nEvidence: highest-confidence package\nApprovals: senior authority + dual control\nRate limits: minimal\nRollback: immediate + mandatory verification\nEligible actions: minimal safe set", fillcolor="#FEF2F2", color="#991B1B"];

  T1 -> T2 -> T3 -> T4 [label="higher consequence narrows eligibility", fontsize=9.0, fontcolor="#204060"];
}
