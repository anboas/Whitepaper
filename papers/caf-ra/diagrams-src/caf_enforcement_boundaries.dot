digraph CAFBoundaries {
  rankdir=LR;
  graph [
    bgcolor="white",
    pad="0.20",
    nodesep="0.58",
    ranksep="0.72",
    labelloc="t",
    label="CAF Enforcement at Real Boundaries"
  ];

  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#204060", fontname="Arial", fontsize=10.8];
  edge [color="#204060", arrowsize=0.76, penwidth=1.25];

  Decision [label="Decision Record\n(policy hash + ASM hash + evidence refs)", fillcolor="#EEF6FF"];

  subgraph cluster_factory {
    label="Software Factory";
    color="#94A3B8";
    style="rounded,dashed";
    Merge [label="Merge Gate"];
    Promote [label="Promotion Gate"];
  }

  subgraph cluster_runtime {
    label="Runtime";
    color="#94A3B8";
    style="rounded,dashed";
    Admission [label="Admission Gate"];
    Segment [label="Segmentation Gate"];
    Data [label="Data-Access Gate"];
  }

  subgraph cluster_response {
    label="Response";
    color="#94A3B8";
    style="rounded,dashed";
    Response [label="Bounded Response\nAutomation Gate"];
  }

  Verify [label="Independent Verification\n(closes loop)", fillcolor="#ECFDF5", color="#166534"];
  Ledger [label="Proof Ledger / Anchoring", fillcolor="#ECFDF5", color="#166534"];

  Decision -> Merge [style=dashed, color="#9A3412", penwidth=1.35];
  Decision -> Promote [style=dashed, color="#9A3412", penwidth=1.35];
  Decision -> Admission [style=dashed, color="#9A3412", penwidth=1.35];
  Decision -> Segment [style=dashed, color="#9A3412", penwidth=1.35];
  Decision -> Data [style=dashed, color="#9A3412", penwidth=1.35];
  Decision -> Response [style=dashed, color="#9A3412", penwidth=1.35];

  Merge -> Verify [style=bold, color="#166534", penwidth=2.0];
  Promote -> Verify [style=bold, color="#166534", penwidth=2.0];
  Admission -> Verify [style=bold, color="#166534", penwidth=2.0];
  Segment -> Verify [style=bold, color="#166534", penwidth=2.0];
  Data -> Verify [style=bold, color="#166534", penwidth=2.0];
  Response -> Verify [style=bold, color="#166534", penwidth=2.0];

  Decision -> Ledger [style=bold, color="#166534", penwidth=2.0, label="anchor decision", fontsize=9.0, fontcolor="#166534"];
  Verify -> Ledger [style=bold, color="#166534", penwidth=2.0, label="anchor closure", fontsize=9.0, fontcolor="#166534"];
  Ledger -> Decision [style=dotted, color="#64748B", label="reference-only linkage", fontsize=8.7, fontcolor="#64748B"];

  Legend [
    shape=box,
    style="rounded,filled",
    fillcolor="#F8FAFC",
    color="#64748B",
    fontname="Arial",
    fontsize=8.8,
    margin="0.06,0.05",
    label="Legend: solid = data flow | dashed = authority/control constraint | dotted = reference-only linkage | bold solid = verification/closure"
  ];

  { rank=sink; Legend; }
  Ledger -> Legend [style=invis, weight=0.01, constraint=false];
}
