digraph ACP_OV1_Clean {
	graph [
		fontname=Helvetica fontsize=10
		label="Agent Control Plane (ACP) — OV-1" labelloc=t
		rankdir=LR
		bgcolor="white"
		splines=ortho
		nodesep=0.45
		ranksep=0.60
	]
	node [
		fontname=Helvetica fontsize=10
		shape=box
		style="rounded,filled"
		fillcolor="#FFFFFF"
		color="#27364A"
		penwidth=1.65
		margin="0.18,0.10"
	]
	edge [
		fontname=Helvetica fontsize=9
		color="#1F2937"
		penwidth=1.25
		arrowsize=0.9
	]

	subgraph cluster_enterprise {
		label="Already existing enterprise baseline"
		style="rounded"
		color="#6F7E8C"
		penwidth=1.45
		ICAM [label="Enterprise ICAM\n(PE + NPE)" fillcolor="#FFFFFF" color="#6F7E8C"]
		ZT [label="Zero Trust / CNAP\n(ingress + egress)" fillcolor="#FFFFFF" color="#6F7E8C"]
		DSO [label="DevSecOps Platform\n(CI/CD + supply chain)" fillcolor="#FFFFFF" color="#6F7E8C"]
		SOC [label="SOC/CSSP\n(SIEM/SOAR)" fillcolor="#FFFFFF" color="#6F7E8C"]
	}

	subgraph cluster_control {
		label="ACP-RA specifically constitutes this control plane"
		style="rounded"
		color="#5F84C2"
		penwidth=1.65
		AR [label="1) Agent Registry\n+ Persona Issuance" fillcolor="#FFFFFF" color="#5F84C2"]
		TS [label="2) Trust Scope Service\n(manifests)" fillcolor="#FFFFFF" color="#5F84C2"]
		POL [label="3) Policy Engine\n(PDP + policy-as-code)" fillcolor="#FFFFFF" color="#5F84C2"]
		MG [label="4) Model Gateway" fillcolor="#FFFFFF" color="#5F84C2"]
		DG [label="4) Data/Context Gateway" fillcolor="#FFFFFF" color="#5F84C2"]
		TG [label="4) Tool/Action Gateway" fillcolor="#FFFFFF" color="#5F84C2"]
		EH [label="5) Eval Harness\n+ Safety Gates" fillcolor="#FFFFFF" color="#5F84C2"]
		EL [label="6) Evidence Ledger" fillcolor="#FFFFFF" color="#5F84C2"]
		OB [label="6) Observability Plane" fillcolor="#FFFFFF" color="#5F84C2"]
	}

	subgraph cluster_runtime {
		label="Runtime plane (mission-specific execution layer)"
		style="rounded"
		color="#72A858"
		penwidth=1.45
		RT [label="Agent Runtime(s)\n(K8s / container / edge)" fillcolor="#FFFFFF" color="#72A858"]
		KB [label="Knowledge Stores" fillcolor="#FFFFFF" color="#72A858"]
		TOOLS [label="Tool Runtimes" fillcolor="#FFFFFF" color="#72A858"]
	}

	ICAM -> AR [label="identities\n+ attributes"]
	DSO -> EH [label="CI gates"]
	EH -> RT [label="deploy\n(agents/policies/tools)"]
	ZT -> RT [label="ZT controls" style=dashed color="#6B7280"]

	RT -> MG [label=model]
	RT -> DG [label=context]
	DG -> KB
	RT -> TG [label=actions]
	TG -> TOOLS

	TS -> POL [label="scope\nconstraints"]
	POL -> MG [style=dotted color="#6B7280"]
	POL -> DG [style=dotted color="#6B7280"]
	POL -> TG [style=dotted color="#6B7280"]

	MG -> EL
	DG -> EL
	TG -> EL
	RT -> EL [label="execution\ntrace"]

	RT -> OB [label=telemetry]
	OB -> SOC [label=alerts]
}
