digraph ACP_OV1_Clean {
	graph [
		fontname=Helvetica fontsize=10
		label="Agent Control Plane (ACP) — OV-1 (Color-Coded, Outline-First)" labelloc=t
		rankdir=LR
		bgcolor="white"
		splines=ortho
		nodesep=0.45
		ranksep=0.60
	]
	node [
		fontname=Helvetica fontsize=10
		shape=box
		style="rounded,filled"
		fillcolor="#FFFFFF"
		color="#2F3B52"
		penwidth=1.4
		margin="0.18,0.10"
	]
	edge [
		fontname=Helvetica fontsize=9
		color="#1F2937"
		penwidth=1.2
		arrowsize=0.9
	]

	subgraph cluster_enterprise {
		label="Already existing enterprise baseline"
		style="rounded"
		color="#7F8C8D"
		penwidth=1.2
		ICAM [label="Enterprise ICAM\n(PE + NPE)" fillcolor="#FFFFFF" color="#7F8C8D"]
		ZT [label="Zero Trust / CNAP\n(ingress + egress)" fillcolor="#FFFFFF" color="#7F8C8D"]
		DSO [label="DevSecOps Platform\n(CI/CD + supply chain)" fillcolor="#FFFFFF" color="#7F8C8D"]
		SOC [label="SOC/CSSP\n(SIEM/SOAR)" fillcolor="#FFFFFF" color="#7F8C8D"]
	}

	subgraph cluster_control {
		label="ACP-RA specifically constitutes this control plane"
		style="rounded"
		color="#6C8EBF"
		penwidth=1.4
		AR [label="1) Agent Registry\n+ Persona Issuance" fillcolor="#FFFFFF" color="#6C8EBF"]
		TS [label="2) Trust Scope Service\n(manifests)" fillcolor="#FFFFFF" color="#6C8EBF"]
		POL [label="3) Policy Engine\n(PDP + policy-as-code)" fillcolor="#FFFFFF" color="#6C8EBF"]
		MG [label="4) Model Gateway" fillcolor="#FFFFFF" color="#6C8EBF"]
		DG [label="4) Data/Context Gateway" fillcolor="#FFFFFF" color="#6C8EBF"]
		TG [label="4) Tool/Action Gateway" fillcolor="#FFFFFF" color="#6C8EBF"]
		EH [label="5) Eval Harness\n+ Safety Gates" fillcolor="#FFFFFF" color="#6C8EBF"]
		EL [label="6) Evidence Ledger" fillcolor="#FFFFFF" color="#6C8EBF"]
		OB [label="6) Observability Plane" fillcolor="#FFFFFF" color="#6C8EBF"]
	}

	subgraph cluster_runtime {
		label="Runtime plane (mission-specific execution layer)"
		style="rounded"
		color="#82B366"
		penwidth=1.2
		RT [label="Agent Runtime(s)\n(K8s / container / edge)" fillcolor="#FFFFFF" color="#82B366"]
		KB [label="Knowledge Stores" fillcolor="#FFFFFF" color="#82B366"]
		TOOLS [label="Tool Runtimes" fillcolor="#FFFFFF" color="#82B366"]
	}

	subgraph cluster_legend {
		label="Key (outline colors)"
		style="rounded,dashed"
		color="#B0B7C3"
		penwidth=0.9
		fontsize=8
		node [fontsize=8 margin="0.10,0.06" penwidth=1.1]
		LEG_EXIST [label="Existing baseline" fillcolor="#FFFFFF" color="#7F8C8D"]
		LEG_ACP [label="ACP-RA control plane" fillcolor="#FFFFFF" color="#6C8EBF"]
		LEG_RUNTIME [label="Runtime execution" fillcolor="#FFFFFF" color="#82B366"]
	}

	ICAM -> AR [label="identities\n+ attributes"]
	DSO -> EH [label="CI gates"]
	EH -> RT [label="deploy\n(agents/policies/tools)"]
	ZT -> RT [label="ZT controls" style=dashed color="#6B7280"]

	RT -> MG [label=model]
	RT -> DG [label=context]
	DG -> KB
	RT -> TG [label=actions]
	TG -> TOOLS

	TS -> POL [label="scope\nconstraints"]
	POL -> MG [style=dotted color="#6B7280"]
	POL -> DG [style=dotted color="#6B7280"]
	POL -> TG [style=dotted color="#6B7280"]

	MG -> EL
	DG -> EL
	TG -> EL
	RT -> EL [label="execution\ntrace"]

	RT -> OB [label=telemetry]
	OB -> SOC [label=alerts]
}
