digraph ACP_OV1_Clean {
	graph [
		fontname=Helvetica fontsize=10
		label="Agent Control Plane (ACP) — OV-1 (Color-Coded)" labelloc=t
		rankdir=LR
		bgcolor="white"
		splines=ortho
		nodesep=0.45
		ranksep=0.60
	]
	node [
		fontname=Helvetica fontsize=10
		shape=box
		style="rounded,filled"
		fillcolor="#F8FAFC"
		color="#204060"
		penwidth=1.4
		margin="0.18,0.10"
	]
	edge [
		fontname=Helvetica fontsize=9
		color="#1F2937"
		penwidth=1.2
		arrowsize=0.9
	]

	subgraph cluster_enterprise {
		label="Already existing enterprise baseline"
		style="rounded"
		color="#94A3B8"
		penwidth=1.2
		ICAM [label="Enterprise ICAM\n(PE + NPE)" fillcolor="#E2E8F0" color="#475569"]
		ZT [label="Zero Trust / CNAP\n(ingress + egress)" fillcolor="#E2E8F0" color="#475569"]
		DSO [label="DevSecOps Platform\n(CI/CD + supply chain)" fillcolor="#E2E8F0" color="#475569"]
		SOC [label="SOC/CSSP\n(SIEM/SOAR)" fillcolor="#E2E8F0" color="#475569"]
	}

	subgraph cluster_control {
		label="ACP-RA specifically constitutes this control plane"
		style="rounded"
		color="#0F766E"
		penwidth=1.4
		AR [label="1) Agent Registry\n+ Persona Issuance" fillcolor="#CCFBF1" color="#0F766E"]
		TS [label="2) Trust Scope Service\n(manifests)" fillcolor="#CCFBF1" color="#0F766E"]
		POL [label="3) Policy Engine\n(PDP + policy-as-code)" fillcolor="#CCFBF1" color="#0F766E"]
		MG [label="4) Model Gateway" fillcolor="#CCFBF1" color="#0F766E"]
		DG [label="4) Data/Context Gateway" fillcolor="#CCFBF1" color="#0F766E"]
		TG [label="4) Tool/Action Gateway" fillcolor="#CCFBF1" color="#0F766E"]
		EH [label="5) Eval Harness\n+ Safety Gates" fillcolor="#CCFBF1" color="#0F766E"]
		EL [label="6) Evidence Ledger" fillcolor="#CCFBF1" color="#0F766E"]
		OB [label="6) Observability Plane" fillcolor="#CCFBF1" color="#0F766E"]
	}

	subgraph cluster_runtime {
		label="Runtime plane (mission-specific execution layer)"
		style="rounded"
		color="#86EFAC"
		penwidth=1.2
		RT [label="Agent Runtime(s)\n(K8s / container / edge)" fillcolor="#DCFCE7" color="#15803D"]
		KB [label="Knowledge Stores" fillcolor="#DCFCE7" color="#15803D"]
		TOOLS [label="Tool Runtimes" fillcolor="#DCFCE7" color="#15803D"]
	}

	subgraph cluster_legend {
		label="Key"
		style="rounded,dashed"
		color="#94A3B8"
		penwidth=1.0
		LEG_EXIST [label="Already existing baseline" fillcolor="#E2E8F0" color="#475569"]
		LEG_ACP [label="ACP-RA constituted control-plane components" fillcolor="#CCFBF1" color="#0F766E"]
		LEG_RUNTIME [label="Runtime execution layer (integrated/mission-specific)" fillcolor="#DCFCE7" color="#15803D"]
		LEG_NOTE [
			shape=note
			style="filled"
			fillcolor="#FEF9C3"
			color="#A16207"
			label="Reading guide:\nRe-use enterprise controls,\ninsert ACP-RA control plane,\nand enforce runtime through gateways + policy + evidence."
		]
	}

	ICAM -> AR [label="identities\n+ attributes"]
	DSO -> EH [label="CI gates"]
	EH -> RT [label="deploy\n(agents/policies/tools)"]
	ZT -> RT [label="ZT controls" style=dashed color="#6B7280"]

	RT -> MG [label=model]
	RT -> DG [label=context]
	DG -> KB
	RT -> TG [label=actions]
	TG -> TOOLS

	TS -> POL [label="scope\nconstraints"]
	POL -> MG [style=dotted color="#6B7280"]
	POL -> DG [style=dotted color="#6B7280"]
	POL -> TG [style=dotted color="#6B7280"]

	MG -> EL
	DG -> EL
	TG -> EL
	RT -> EL [label="execution\ntrace"]

	RT -> OB [label=telemetry]
	OB -> SOC [label=alerts]
}
