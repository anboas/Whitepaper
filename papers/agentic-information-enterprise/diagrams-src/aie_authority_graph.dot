digraph AIEAuthorityGraph {
  graph [
    rankdir=TB,
    bgcolor="#ffffff",
    pad="0.35",
    nodesep="0.45",
    ranksep="0.60",
    splines=ortho,
    fontname="Arial",
    labelloc="t",
    label="Authority and Responsibility Graph",
    fontsize=22,
    fontcolor="#0f172a"
  ];

  node [
    shape=rect,
    style="rounded,filled",
    color="#475569",
    penwidth=1.4,
    fillcolor="#f8fafc",
    fontname="Arial",
    fontsize=13,
    fontcolor="#0f172a",
    margin="0.14,0.09"
  ];

  edge [
    color="#64748b",
    penwidth=1.35,
    arrowsize=0.75,
    fontname="Arial",
    fontsize=10,
    fontcolor="#334155"
  ];

  authority [label="Authority Source\nLaw, policy, appointment,\nwarrant, mission rule", fillcolor="#ecfeff", color="#0891b2"];
  official [label="Accountable Official\nretains governmental authority", fillcolor="#fff1f2", color="#e11d48"];
  wep [label="Approved WEP\nemployment boundary", fillcolor="#fffbeb", color="#d97706"];
  workclass [label="Delegable Work Class\neligible, prohibited,\nexception-only work", fillcolor="#f8fafc", color="#475569"];
  workunit [label="Assigned Work Unit\nsource, outcome,\ncriteria, owner", fillcolor="#f8fafc", color="#475569"];
  action [label="Agent NPE + ACP\nmediated action", fillcolor="#eff6ff", color="#2563eb"];
  evidence [label="CAF Evidence\nsources, actions,\noutputs, exceptions", fillcolor="#f0fdf4", color="#16a34a"];
  acceptance [label="Human Acceptance\nor reserved decision", fillcolor="#fff1f2", color="#e11d48"];

  { rank=same; workunit; action; evidence; }

  authority -> official;
  official -> wep;
  wep -> workclass;
  workclass -> workunit;
  workunit -> action;
  action -> evidence;
  evidence -> acceptance;
}
